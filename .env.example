# Use a URL de incorporação do Google Forms, terminando em viewform?embedded=true
NEXT_PUBLIC_GOOGLE_FORM_URL=https://docs.google.com/forms/d/e/SEU_FORMULARIO/viewform?embedded=true

# Chave privada usada somente pelo servidor para criar Orders do Checkout Pro
# Use a credencial de teste durante os testes e a de produção no deploy final
MERCADO_PAGO_ACCESS_TOKEN=APP_USR-sua-chave-privada

# Use true somente com credenciais de teste; remova ou use false em produção
MERCADO_PAGO_TEST_MODE=false

# Chave secreta gerada em Mercado Pago > Suas integrações > Webhooks
MERCADO_PAGO_WEBHOOK_SECRET=sua-chave-secreta-do-webhook
# Opcional durante os testes, caso o ambiente de teste tenha outra chave
MERCADO_PAGO_WEBHOOK_SECRET_TEST=sua-chave-secreta-do-webhook-de-teste

# Serviço de e-mail transacional Resend (credenciais somente no servidor)
RESEND_API_KEY=re_sua-chave-do-resend
EMAIL_FROM=Cha de Bebe <presentes@tonessa.baby>
NOTIFICATION_EMAIL=seu-email@exemplo.com
# Opcional: recebe no seu e-mail a mensagem destinada ao comprador fictício
EMAIL_TEST_RECIPIENT=seu-email@exemplo.com

# URL pública do site em produção, sem barra no final
SITE_URL=https://tonessa.baby
