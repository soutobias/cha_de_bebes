# Use a URL de incorporação do Google Forms, terminando em viewform?embedded=true
NEXT_PUBLIC_GOOGLE_FORM_URL=https://docs.google.com/forms/d/e/SEU_FORMULARIO/viewform?embedded=true

# Chave privada usada somente pelo servidor para criar Orders do Checkout Pro
# Use a credencial de teste durante os testes e a de produção no deploy final
MERCADO_PAGO_ACCESS_TOKEN=APP_USR-sua-chave-privada
# URL pública do site em produção, sem barra no final
SITE_URL=https://tonessa.baby
